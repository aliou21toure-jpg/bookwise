{
  "name": "bookwise",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:worker": "esbuild src/jobs/worker.ts scripts/migrate.ts scripts/admin-create.ts --bundle --platform=node --target=node22 --format=esm --conditions=react-server --packages=external --alias:@=./src --alias:server-only=./scripts/shims/server-only.ts --entry-names=[name] --out-extension:.js=.mjs --outdir=dist",
    "start": "next start",
    "start:worker": "BOOKWISE_SERVICE=worker node dist/worker.mjs",
    "worker:dev": "tsx --conditions=react-server --env-file=.env.local src/jobs/worker.ts",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:migrate:test": "tsx --env-file=.env.test scripts/migrate.ts",
    "admin:create": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/admin-create.ts",
    "seed:demo": "MAIL_TRANSPORT=memory RATE_LIMITS=false LOG_LEVEL=warn tsx --conditions=react-server --env-file-if-exists=.env.local scripts/seed-demo.ts",
    "openapi": "tsx --conditions=react-server scripts/openapi.ts"
  },
  "dependencies": {
    "@date-fns/tz": "1.5.0",
    "@hookform/resolvers": "7.0.2",
    "@radix-ui/react-slot": "1.5.0",
    "@stripe/react-stripe-js": "7.0.0",
    "@stripe/stripe-js": "10.1.0",
    "better-auth": "1.7.17",
    "bullmq": "6.7.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "drizzle-orm": "0.45.4",
    "geist": "1.9.1",
    "ioredis": "6.0.0",
    "lucide-react": "1.68.0",
    "next": "16.4.5",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "stripe": "23.0.0",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "4.3.4",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "pino-pretty": "13.2.0",
    "tailwindcss": "4.3.4",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
