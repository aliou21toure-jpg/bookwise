# Copy to .env.local for development. Never commit real values.
APP_URL=http://localhost:3000

# Application role (cannot bypass row-level security)
DATABASE_URL=postgres://bookwise_app:app_local_pw@localhost:5432/bookwise_dev
DATABASE_POOL_MAX=10
# Schema owner, used only to run migrations
DATABASE_MIGRATION_URL=postgres://bookwise_owner:owner_local_pw@localhost:5432/bookwise_dev

REDIS_URL=redis://localhost:6379

# 32+ random characters: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-at-least-32-random-characters
REQUIRE_EMAIL_VERIFICATION=true

LOG_LEVEL=info
